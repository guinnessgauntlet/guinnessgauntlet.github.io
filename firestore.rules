rules_version = '2';

// Guinness Gauntlet database rules.
// Anyone who opens the site is signed in anonymously and can read everything.
// The league's own data (people, picks, draft, settings, results) can be changed from the site.
// Score-feed bookkeeping (meta, sync) can only be written by the GitHub updater,
// which uses a service account and bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && collection in ['members', 'picks', 'draft', 'config', 'results']
        && request.resource.data.size() < 60;
      allow delete: if request.auth != null
        && collection in ['members', 'picks'];
    }
  }
}
