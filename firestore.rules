rules_version = '2';

// Guinness Gauntlet database rules.
// Everyone who opens the site is signed in anonymously: they can view the league,
// make draft picks and tap "This is me" on their name.
// Scores and settings can only be changed by the commissioner's Google account.
// The hourly GitHub updater uses a service account and bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function commissioner() {
      return signedIn()
        && request.auth.token.email == 'PASTE_COMMISSIONER_EMAIL'
        && request.auth.token.email_verified == true;
    }
    function smallDoc() { return request.resource.data.size() < 60; }

    match /{collection}/{docId} {
      allow read: if signedIn();

      // Draft: anyone in the league can pick; the commissioner can do everything.
      allow create, update: if smallDoc() && (
        commissioner()
        || (signedIn() && collection in ['members', 'picks', 'draft'])
      );
      allow delete: if commissioner();

      // results, config: commissioner only (covered by commissioner() above).
      // meta, sync: written only by the updater.
    }
  }
}
